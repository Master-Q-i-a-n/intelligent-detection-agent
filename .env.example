# 复制本文件为 .env 后填写真实密钥。
# .env 仅保存在本机，不要提交到代码仓库或发送给他人。
DEEPSEEK_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 多轮对话 Agent。未填写时依次沿用上面的 DEEPSEEK_API_KEY、LLM_BASE_URL 和 LLM_MODEL。
CHAT_LLM_PROVIDER=deepseek
CHAT_LLM_API_KEY=
CHAT_LLM_BASE_URL=https://api.deepseek.com
CHAT_LLM_MODEL=deepseek-v4-flash-vision-exp
# DeepSeek 携带工具并开启思考时，应用会在后端保存并回传 reasoning_content，但不会展示给前端。
CHAT_LLM_THINKING=enabled
CHAT_LLM_REASONING_EFFORT=high

# 综合测评的独立评审模型。留空时沿用 CHAT_LLM_*；评审固定关闭思考且不计入被测指标。
EVAL_JUDGE_PROVIDER=
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_MODEL=

# LangSmith 可观测性默认关闭；只有开启并填写有效 Key 后才会上传 Trace。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=intelligent-detection-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 可选：生产环境隐藏发送给模型的输入或模型输出。
# LANGCHAIN_HIDE_INPUTS=true
# LANGCHAIN_HIDE_OUTPUTS=true

# 安全作业多模态复核与内部通知。真实值只放在 .env。
ARK_API_KEY=your_ark_api_key_here
ARK_MODEL_ID=your_ark_video_model_id_here
SAFETY_AGENT_TOKEN=replace_with_a_long_random_token
# 生产 HTTPS 部署时设为 true；本地 HTTP 开发保持 false。
AUTH_COOKIE_SECURE=false
LANGGRAPH_STRICT_MSGPACK=true
