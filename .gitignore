frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/.vite/
frontend/coverage/
output/playwright/
.playwright-cli/

# uv / Python 工具缓存（uv.lock 应提交）
.uv-cache/
.python-version.local

# 旧版随项目复制的第三方运行库，改由 .venv 管理
runtime_libs/

